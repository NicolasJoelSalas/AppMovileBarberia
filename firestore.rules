rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function esBarberoHabilitado() {
      return request.auth != null
        && exists(/databases/$(database)/documents/barberos/$(request.auth.uid))
        && get(/databases/$(database)/documents/barberos/$(request.auth.uid)).data.Estado == true;
    }

    function esCliente() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/barberos/$(request.auth.uid))
        && exists(/databases/$(database)/documents/clientes/$(request.auth.uid));
    }

    function servicioHabilitado(id, barberoId) {
      let servicio = get(/databases/$(database)/documents/servicios/$(id)).data;
      return servicio.Duracion == 40
        && servicio.BarberoId == barberoId
        && (('Estado' in servicio && servicio.Estado == true)
          || (!('Estado' in servicio) && servicio.Activo == true));
    }

    function horarioPublicable(id, h) {
      return reservasAnteriores(h.BarberoId) && h.keys().hasOnly(['BarberoId', 'Inicio', 'Fin', 'Estado', 'Agenda', 'AgendaId', 'ZonaHoraria'])
        && h.AgendaId is string
        && h.BarberoId == request.auth.uid
        && h.Inicio is timestamp && h.Fin is timestamp
        && h.Inicio > request.time && h.Fin - h.Inicio == duration.value(40, 'm')
        && id == h.BarberoId + '_' + string(h.Inicio.toMillis())
        && h.Estado == 'libre'
        && h.Agenda == get(/databases/$(database)/documents/barberos/$(h.BarberoId)/agenda/$(h.AgendaId)).data
        && h.ZonaHoraria == get(/databases/$(database)/documents/barberos/$(h.BarberoId)).data.ZonaHoraria;
    }

    function referenciaValida(t) {
      return !('ReferenciaCorteUrl' in t) || t.ReferenciaCorteUrl == null
        || (t.ReferenciaCorteUrl is string && t.ReferenciaCorteUrl.size() <= 2048
          && t.ReferenciaCorteUrl.matches('https://res[.]cloudinary[.]com/[^/]+/image/upload/.+'));
    }

    // Las cuentas que publican la agenda por minutos usan las transacciones nuevas, compatibles con Spark.
    function reservasAnteriores(barberoId) {
      return get(/databases/$(database)/documents/barberos/$(barberoId)).data.get('ReservasVersion', 1) != 3;
    }
    function turnoValido(id, t) {
      let horarioPath = /databases/$(database)/documents/horarios/$(t.HorarioId);
      let antes = get(horarioPath).data;
      let despues = getAfter(horarioPath).data;
      let barbero = get(/databases/$(database)/documents/barberos/$(t.BarberoId)).data;
      return t.keys().hasAll(['ClienteId', 'BarberoId', 'ServicioId', 'HorarioId', 'Inicio', 'Fin', 'Estado', 'CreadoEn'])
        && t.keys().hasOnly(['ClienteId', 'BarberoId', 'ServicioId', 'HorarioId', 'Inicio', 'Fin', 'Estado', 'CreadoEn', 'ReferenciaCorteUrl'])
        && referenciaValida(t)
        && t.ClienteId == request.auth.uid && t.Estado == 'confirmado' && t.CreadoEn == request.time
        && reservasAnteriores(t.BarberoId) && barbero.Estado == true && servicioHabilitado(t.ServicioId, t.BarberoId)
        && antes.Estado == 'libre' && despues.Estado == 'ocupado' && despues.TurnoId == id
        && t.BarberoId == antes.BarberoId && t.Inicio == antes.Inicio && t.Fin == antes.Fin
        && t.Inicio > request.time && t.Fin - t.Inicio == duration.value(40, 'm')
        && antes.AgendaId is string
        && antes.Agenda == get(/databases/$(database)/documents/barberos/$(t.BarberoId)/agenda/$(antes.AgendaId)).data
        && antes.ZonaHoraria == barbero.ZonaHoraria;
    }

    function editable(t) {
      return esCliente() && reservasAnteriores(t.BarberoId) && t.ClienteId == request.auth.uid
        && t.Estado in ['confirmado', 'Confirmado', 'pendiente', 'Pendiente'] && t.Inicio > request.time;
    }
    function estadoLiberado(h) {
      return h.Agenda == get(/databases/$(database)/documents/barberos/$(h.BarberoId)/agenda/$(h.AgendaId)).data
        && h.ZonaHoraria == get(/databases/$(database)/documents/barberos/$(h.BarberoId)).data.ZonaHoraria
        ? 'libre' : 'bloqueado';
    }
    function liberado(horarioId, turnoId) {
      let antes = get(/databases/$(database)/documents/horarios/$(horarioId)).data;
      let despues = getAfter(/databases/$(database)/documents/horarios/$(horarioId)).data;
      return antes.Estado == 'ocupado' && antes.TurnoId == turnoId
        && despues.Estado == estadoLiberado(antes) && !('TurnoId' in despues);
    }
    function cambioValido(id, antes, t) {
      let h = get(/databases/$(database)/documents/horarios/$(t.HorarioId)).data;
      let despues = getAfter(/databases/$(database)/documents/horarios/$(t.HorarioId)).data;
      let b = get(/databases/$(database)/documents/barberos/$(t.BarberoId)).data;
      return editable(antes) && reservasAnteriores(t.BarberoId)
        && t.diff(antes).affectedKeys().hasOnly(['BarberoId', 'ServicioId', 'HorarioId', 'Inicio', 'Fin', 'Estado', 'ReferenciaCorteUrl'])
        && referenciaValida(t)
        && t.Estado == 'confirmado' && b.Estado == true && servicioHabilitado(t.ServicioId, t.BarberoId)
        && t.BarberoId == h.BarberoId && t.Inicio == h.Inicio && t.Fin == h.Fin
        && t.Inicio > request.time && t.Fin - t.Inicio == duration.value(40, 'm')
        && h.Agenda == get(/databases/$(database)/documents/barberos/$(t.BarberoId)/agenda/$(h.AgendaId)).data
        && h.ZonaHoraria == b.ZonaHoraria && despues.Estado == 'ocupado' && despues.TurnoId == id
        && ((antes.HorarioId == t.HorarioId && h.Estado == 'ocupado' && h.TurnoId == id)
          || (antes.HorarioId != t.HorarioId && h.Estado == 'libre' && liberado(antes.HorarioId, id)));
    }
    function liberarHorario(id, h, nuevo) {
      let antes = get(/databases/$(database)/documents/turnos/$(h.TurnoId)).data;
      let despues = getAfter(/databases/$(database)/documents/turnos/$(h.TurnoId)).data;
      return editable(antes) && antes.HorarioId == id && h.Estado == 'ocupado'
        && nuevo.diff(h).affectedKeys().hasOnly(['Estado', 'TurnoId'])
        && !('TurnoId' in nuevo) && nuevo.Estado == estadoLiberado(h)
        && (despues.Estado == 'cancelado' || despues.HorarioId != id);
    }

    function cancelacionBarbero(id, antes, despues) {
      let h = get(/databases/$(database)/documents/horarios/$(antes.HorarioId)).data;
      let nuevo = getAfter(/databases/$(database)/documents/horarios/$(antes.HorarioId)).data;
      return esBarberoHabilitado() && reservasAnteriores(antes.BarberoId) && antes.BarberoId == request.auth.uid
        && antes.Estado in ['confirmado', 'Confirmado', 'pendiente', 'Pendiente']
        && antes.Inicio > request.time
        && despues.diff(antes).affectedKeys().hasOnly(['Estado', 'CanceladoEn', 'CanceladoPor'])
        && despues.CanceladoPor == request.auth.uid
        && despues.Estado == 'cancelado' && despues.CanceladoEn == request.time
        && h.BarberoId == request.auth.uid && h.Estado == 'ocupado' && h.TurnoId == id
        && nuevo.diff(h).affectedKeys().hasOnly(['Estado', 'TurnoId'])
        && (nuevo.Estado == 'bloqueado' || nuevo.Estado == estadoLiberado(h))
        && !('TurnoId' in nuevo);
    }

    // Una máscara pública de 0/1 por minuto permite validar el intervalo completo,
    // sin iteraciones, consultas de otros clientes ni funciones de pago.
    function comienzo(t, d) { return int((t.Inicio.toMillis() - d.Inicio.toMillis()) / 60000); }
    function termino(t, d) { return int((t.Fin.toMillis() - d.Inicio.toMillis()) / 60000); }
    function rangoValido(t, d) {
      return t.Inicio is timestamp && t.Fin is timestamp && t.Fin > t.Inicio
        && t.Inicio >= d.Inicio && t.Fin <= d.Fin
        && (t.Inicio.toMillis() - d.Inicio.toMillis()) % 60000 == 0
        && (t.Fin.toMillis() - d.Inicio.toMillis()) % 60000 == 0;
    }
    function liberarMinutos(m, t, d) {
      let a = comienzo(t, d);
      let b = termino(t, d);
      return m[0:a] + m[a:b].replace('1', '0') + m[b:m.size()];
    }
    function ocuparMinutos(m, t, d) {
      let a = comienzo(t, d);
      let b = termino(t, d);
      return m[0:a] + m[a:b].replace('0', '1') + m[b:m.size()];
    }
    function diaAnterior(antes, despues) {
      return antes.get('DiaId', despues.get('DiaAnteriorId', despues.DiaId));
    }
    function diaVigente(d) {
      return get(/databases/$(database)/documents/barberos/$(d.BarberoId)).data.Estado == true
        && get(/databases/$(database)/documents/barberos/$(d.BarberoId)).data.ReservasVersion == 3
        && d.ZonaHoraria == get(/databases/$(database)/documents/barberos/$(d.BarberoId)).data.ZonaHoraria
        && d.Agenda == get(/databases/$(database)/documents/barberos/$(d.BarberoId)/agenda/$(d.AgendaId)).data;
    }
    function ocupacionNueva(diaId, d, nuevo, anterior, existe, t) {
      let mismo = existe && diaAnterior(anterior, t) == diaId;
      let libre = mismo ? liberarMinutos(d.Ocupacion, anterior, d) : d.Ocupacion;
      return t.Estado == 'confirmado' && t.DiaId == diaId && t.BarberoId == d.BarberoId
        && rangoValido(t, d) && diaVigente(d)
        && (!mismo || (rangoValido(anterior, d) && d.Ocupacion[comienzo(anterior,d):termino(anterior,d)].matches('1+')))
        && d.Atencion[comienzo(t,d):termino(t,d)].matches('1+')
        && libre[comienzo(t,d):termino(t,d)].matches('0+')
        && nuevo.Ocupacion == ocuparMinutos(libre, t, d);
    }
    function ocupacionLiberada(diaId, d, nuevo, anterior, existe, t) {
      return existe && (anterior.Estado == true || anterior.Estado in ['confirmado','Confirmado','pendiente','Pendiente'])
        && diaAnterior(anterior,t) == diaId && anterior.BarberoId == d.BarberoId
        && rangoValido(anterior, d)
        && d.Ocupacion[comienzo(anterior,d):termino(anterior,d)].matches('1+')
        && (t.Estado == 'cancelado' || t.DiaId != diaId)
        && nuevo.Ocupacion == liberarMinutos(d.Ocupacion, anterior, d);
    }
    function mutacionDia(diaId, d, nuevo) {
      let turnoId = nuevo.UltimoTurnoId;
      let ruta = /databases/$(database)/documents/turnos/$(turnoId);
      let existe = exists(ruta);
      let anterior = existe ? get(ruta).data : {};
      let t = getAfter(ruta).data;
      return request.auth != null
        && (t.ClienteId == request.auth.uid || (t.Estado == 'cancelado' && d.BarberoId == request.auth.uid && esBarberoHabilitado()))
        && nuevo.diff(d).affectedKeys().hasOnly(['Ocupacion', 'UltimoTurnoId'])
        && (ocupacionNueva(diaId, d, nuevo, anterior, existe, t)
          || ocupacionLiberada(diaId, d, nuevo, anterior, existe, t));
    }
    function ocupaDia(turnoId, t) {
      let ruta = /databases/$(database)/documents/disponibilidad/$(t.DiaId);
      let antes = get(ruta).data;
      let despues = getAfter(ruta).data;
      let turnoPath = /databases/$(database)/documents/turnos/$(turnoId);
      // Si los minutos cambiaron, hubo una escritura del día, cuya regla valida el cambio exacto.
      // Una edición sin cambio de intervalo puede conservar la misma máscara.
      return despues.UltimoTurnoId == turnoId
        && (antes.Ocupacion != despues.Ocupacion
          || (exists(turnoPath) && get(turnoPath).data.get('DiaId', t.get('DiaAnteriorId','')) == t.DiaId
            && get(turnoPath).data.Inicio == t.Inicio && get(turnoPath).data.Fin == t.Fin));
    }
    function liberaDia(turnoId, antes, despues) {
      let diaId = diaAnterior(antes, despues);
      let ruta = /databases/$(database)/documents/disponibilidad/$(diaId);
      let d = get(ruta).data;
      let nuevo = getAfter(ruta).data;
      return nuevo.UltimoTurnoId == turnoId && rangoValido(antes,d)
        && d.Ocupacion[comienzo(antes,d):termino(antes,d)].matches('1+')
        && nuevo.Ocupacion[comienzo(antes,d):termino(antes,d)].matches('0+');
    }
    function datosReservaMinutos(t) {
      let servicio = get(/databases/$(database)/documents/servicios/$(t.ServicioId)).data;
      let d = get(/databases/$(database)/documents/disponibilidad/$(t.DiaId)).data;
      return t.ReservaVersion == 3 && t.DuracionMinutos is int
        && t.DuracionMinutos >= 5 && t.DuracionMinutos <= 240
        && servicio.Duracion == t.DuracionMinutos && servicio.BarberoId == t.BarberoId
        && (servicio.get('Estado', servicio.get('Activo', false)) == true)
        && t.Estado == 'confirmado' && t.ClienteId == request.auth.uid
        && t.Inicio > request.time && t.Fin - t.Inicio == duration.value(t.DuracionMinutos, 'm')
        && t.AgendaId == d.AgendaId && t.BarberoId == d.BarberoId && diaVigente(d)
        && rangoValido(t,d) && d.Atencion[comienzo(t,d):termino(t,d)].matches('1+')
        && t.HorarioId == t.BarberoId + '_' + string(t.Inicio.toMillis())
        && referenciaValida(t);
    }
    function crearReservaMinutos(id, t) {
      return esCliente() && t.keys().hasAll(['ClienteId','BarberoId','ServicioId','HorarioId','DiaId','AgendaId',
          'Inicio','Fin','DuracionMinutos','ReservaVersion','Estado','CreadoEn'])
        && t.keys().hasOnly(['ClienteId','BarberoId','ServicioId','HorarioId','DiaId','AgendaId',
          'Inicio','Fin','DuracionMinutos','ReservaVersion','Estado','CreadoEn','ReferenciaCorteUrl'])
        && t.CreadoEn == request.time && datosReservaMinutos(t) && ocupaDia(id,t);
    }
    function editarReservaMinutos(id, antes, t) {
      return esCliente() && antes.ClienteId == request.auth.uid
        && (antes.Estado == true || antes.Estado in ['confirmado','Confirmado','pendiente','Pendiente'])
        && antes.Inicio > request.time
        && t.diff(antes).affectedKeys().hasOnly(['BarberoId','ServicioId','HorarioId','DiaId','DiaAnteriorId','AgendaId',
          'Inicio','Fin','DuracionMinutos','ReservaVersion','Estado','ReferenciaCorteUrl'])
        && datosReservaMinutos(t) && ocupaDia(id,t)
        && (diaAnterior(antes,t) == t.DiaId || liberaDia(id,antes,t));
    }
    function cancelarReservaMinutos(id, antes, t) {
      return request.auth != null && ((esCliente() && antes.ClienteId == request.auth.uid)
          || (esBarberoHabilitado() && antes.BarberoId == request.auth.uid))
        && (antes.Estado == true || antes.Estado in ['confirmado','Confirmado','pendiente','Pendiente'])
        && antes.Inicio > request.time
        && t.diff(antes).affectedKeys().hasOnly(['Estado','CanceladoEn','CanceladoPor','DiaId','DiaAnteriorId'])
        && t.Estado == 'cancelado' && t.CanceladoPor == request.auth.uid && t.CanceladoEn == request.time
        && t.DiaId == diaAnterior(antes,t) && liberaDia(id,antes,t);
    }
    function datosDia(id, d) {
      return d.keys().hasAll(['BarberoId','Inicio','Fin','Atencion','Ocupacion','Agenda','AgendaId','ZonaHoraria'])
        && id == d.BarberoId + '_' + string(d.Inicio.toMillis())
        && d.Inicio is timestamp && d.Fin is timestamp && d.Fin > d.Inicio
        && d.Atencion is string && d.Ocupacion is string
        && d.Atencion.size() >= 1200 && d.Atencion.size() <= 1560
        && d.Atencion.size() == d.Ocupacion.size()
        && d.Atencion.size() * 60000 == d.Fin.toMillis() - d.Inicio.toMillis()
        && d.Atencion.matches('[01]+') && d.Ocupacion.matches('[01]+');
    }
    match /disponibilidad/{diaId} {
      allow read: if request.auth != null;
      allow create: if esBarberoHabilitado() && request.resource.data.BarberoId == request.auth.uid
        && request.resource.data.keys().hasOnly(['BarberoId','Inicio','Fin','Atencion','Ocupacion','Agenda','AgendaId','ZonaHoraria'])
        && datosDia(diaId, request.resource.data) && diaVigente(request.resource.data);
      allow update: if datosDia(diaId, request.resource.data) && (
        (esBarberoHabilitado() && resource.data.BarberoId == request.auth.uid
          && request.resource.data.Ocupacion == resource.data.Ocupacion
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Atencion','Agenda','AgendaId','ZonaHoraria','UltimoTurnoId'])
          && !('UltimoTurnoId' in request.resource.data) && diaVigente(request.resource.data))
        || mutacionDia(diaId, resource.data, request.resource.data));
      allow delete: if false;
    }

    match /turnos/{turnoId} {
      allow list: if (esBarberoHabilitado() && resource.data.BarberoId == request.auth.uid)
        || (esCliente() && resource.data.ClienteId == request.auth.uid);
      // Solo lectura individual del propio comprobante para reintentar la transacción.
      allow get: if request.auth != null && (!exists(/databases/$(database)/documents/turnos/$(turnoId))
        || resource.data.ClienteId == request.auth.uid
        || (esBarberoHabilitado() && resource.data.BarberoId == request.auth.uid));
      allow create: if (request.resource.data.get('ReservaVersion',1) == 3
          && crearReservaMinutos(turnoId, request.resource.data))
        || (request.resource.data.get('ReservaVersion',1) != 3
          && esCliente() && turnoValido(turnoId, request.resource.data));
      allow update: if (('DiaId' in request.resource.data)
          && request.resource.data.Estado == 'cancelado'
          && cancelarReservaMinutos(turnoId,resource.data,request.resource.data))
        || (('DiaId' in request.resource.data) && request.resource.data.Estado != 'cancelado'
          && editarReservaMinutos(turnoId,resource.data,request.resource.data))
        || (!('DiaId' in request.resource.data)
          && (cancelacionBarbero(turnoId,resource.data,request.resource.data)
            || ((editable(resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Estado','CanceladoEn'])
              && request.resource.data.Estado == 'cancelado' && request.resource.data.CanceladoEn == request.time
              && liberado(resource.data.HorarioId,turnoId))
              || cambioValido(turnoId,resource.data,request.resource.data))));
      allow update: if esBarberoHabilitado()
        && resource.data.BarberoId == request.auth.uid
        && (resource.data.Estado == true || resource.data.Estado in ['confirmado', 'Confirmado', 'pendiente', 'Pendiente'])
        && resource.data.Inicio is timestamp && resource.data.Inicio <= request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Estado', 'RealizadoEn', 'PrecioCobrado'])
        && request.resource.data.Estado == 'realizado'
        && request.resource.data.RealizadoEn == request.time
        && request.resource.data.PrecioCobrado is number
        && request.resource.data.PrecioCobrado >= 0 && request.resource.data.PrecioCobrado <= 1000000000
        && math.abs(request.resource.data.PrecioCobrado * 100 - math.round(request.resource.data.PrecioCobrado * 100)) < 0.00001
        && request.resource.data.PrecioCobrado == get(/databases/$(database)/documents/servicios/$(resource.data.ServicioId)).data.Precio;
      allow delete: if false;
    }

    // No contiene nombre, correo ni UID de cliente. Solo disponibilidad y referencia opaca al turno.
    match /horarios/{horarioId} {
      allow read: if request.auth != null;
      allow update: if esBarberoHabilitado() && resource.data.BarberoId == request.auth.uid
        && resource.data.Estado == 'ocupado'
        && get(/databases/$(database)/documents/turnos/$(resource.data.TurnoId)).data.HorarioId == horarioId
        && cancelacionBarbero(resource.data.TurnoId,
          get(/databases/$(database)/documents/turnos/$(resource.data.TurnoId)).data,
          getAfter(/databases/$(database)/documents/turnos/$(resource.data.TurnoId)).data);
      allow update: if esCliente() && (
        (resource.data.Estado == 'ocupado' && liberarHorario(horarioId, resource.data, request.resource.data))
        || (resource.data.Estado == 'libre' && request.resource.data.Estado == 'ocupado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Estado', 'TurnoId'])
          && getAfter(/databases/$(database)/documents/turnos/$(request.resource.data.TurnoId)).data.HorarioId == horarioId
          && cambioValido(request.resource.data.TurnoId,
            get(/databases/$(database)/documents/turnos/$(request.resource.data.TurnoId)).data,
            getAfter(/databases/$(database)/documents/turnos/$(request.resource.data.TurnoId)).data)));
      allow create: if esBarberoHabilitado() && horarioPublicable(horarioId, request.resource.data);
      allow update: if (esBarberoHabilitado() && resource.data.BarberoId == request.auth.uid
          && resource.data.Estado != 'ocupado'
          && (horarioPublicable(horarioId, request.resource.data)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Estado'])
              && request.resource.data.Estado == 'bloqueado')))
        || (esCliente() && resource.data.Estado == 'libre'
          && request.resource.data.Estado == 'ocupado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Estado', 'TurnoId'])
          && request.resource.data.TurnoId is string
          && !exists(/databases/$(database)/documents/turnos/$(request.resource.data.TurnoId))
          && getAfter(/databases/$(database)/documents/turnos/$(request.resource.data.TurnoId)).data.HorarioId == horarioId
          && getAfter(/databases/$(database)/documents/turnos/$(request.resource.data.TurnoId)).data.ClienteId == request.auth.uid);
      allow delete: if false;
    }

    // Cada cuenta puede consultar su propio documento, incluso si todavía no existe.
    match /barberos/{uid} {
      match /dispositivos/{instalacionId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if esBarberoHabilitado() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'actualizadoEn'])
          && request.resource.data.keys().hasAll(['token', 'actualizadoEn'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 4096
          && request.resource.data.actualizadoEn == request.time;
      }
      allow get: if request.auth != null
        && (request.auth.uid == uid || resource.data.Estado == true);
      allow list: if request.auth != null && resource.data.Estado == true;
      allow update: if esBarberoHabilitado() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Nombre', 'ZonaHoraria'])
        && request.resource.data.Nombre is string && request.resource.data.ZonaHoraria is string;
      allow update: if esBarberoHabilitado() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Ubicacion', 'UbicacionActualizadaEn'])
        && request.resource.data.Ubicacion is latlng
        && request.resource.data.Ubicacion.latitude() >= -90 && request.resource.data.Ubicacion.latitude() <= 90
        && request.resource.data.Ubicacion.longitude() >= -180 && request.resource.data.Ubicacion.longitude() <= 180
        && request.resource.data.UbicacionActualizadaEn == request.time;
      allow update: if esBarberoHabilitado() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ReservasVersion'])
        && request.resource.data.ReservasVersion == 3;
      allow create, delete: if false;

      match /agenda/{agendaId} {
        allow read: if request.auth != null;
        allow create, update: if (agendaId == 'semanal' || agendaId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          && esBarberoHabilitado() && request.auth.uid == uid;
        allow delete: if false;
      }
    }

    match /clientes/{uid} {
      allow get: if request.auth != null
        && (request.auth.uid == uid || esBarberoHabilitado());
      allow create: if request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/barberos/$(uid))
        && request.resource.data.keys().hasAll(['Nombre', 'Correo', 'CreadoEn'])
        && request.resource.data.keys().hasOnly(['Nombre', 'Correo', 'CreadoEn'])
        && request.resource.data.Nombre is string
        && request.resource.data.Nombre.size() <= 120
        && request.resource.data.Correo == request.auth.token.email
        && request.resource.data.CreadoEn == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/barberos/$(uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Nombre'])
        && request.resource.data.Nombre is string && request.resource.data.Nombre.size() > 0
        && request.resource.data.Nombre.size() <= 120;
      allow list, delete: if false;
    }

    match /servicios/{servicioId} {
      allow read: if request.auth != null;
      function camposValidos(s) {
        return s.NombreCorte is string && s.NombreCorte.size() > 0 && s.NombreCorte.size() <= 120
          && s.NombreCorte.matches('.*[^ ].*')
          && s.Precio is number && s.Precio >= 0 && s.Precio <= 1000000000
          && math.abs(s.Precio * 100 - math.round(s.Precio * 100)) < 0.00001
          && s.Duracion is int && s.Duracion >= 5 && s.Duracion <= 240
          && s.Estado is bool;
      }
      allow create: if esBarberoHabilitado()
        && request.resource.data.keys().hasAll(['BarberoId', 'NombreCorte', 'Precio', 'Duracion', 'Estado', 'CreadoEn'])
        && request.resource.data.keys().hasOnly(['BarberoId', 'NombreCorte', 'Precio', 'Duracion', 'Estado', 'CreadoEn'])
        && request.resource.data.BarberoId == request.auth.uid
        && request.resource.data.CreadoEn == request.time && camposValidos(request.resource.data);
      allow update: if esBarberoHabilitado() && resource.data.BarberoId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['NombreCorte', 'Precio', 'Duracion', 'Estado'])
        && camposValidos(request.resource.data);
      allow delete: if false;
    }

    match /publicaciones/{publicacionId} {
      allow read: if request.auth != null;
      allow create: if esBarberoHabilitado()
        && request.resource.data.keys().hasAll(['BarberoId', 'BarberoNombre', 'ImagenUrl', 'ImagenPublicId', 'Descripcion', 'CreadoEn'])
        && request.resource.data.keys().hasOnly(['BarberoId', 'BarberoNombre', 'ImagenUrl', 'ImagenPublicId', 'Descripcion', 'CreadoEn'])
        && request.resource.data.BarberoId == request.auth.uid
        && request.resource.data.BarberoNombre == get(/databases/$(database)/documents/barberos/$(request.auth.uid)).data.Nombre
        && request.resource.data.ImagenUrl is string && request.resource.data.ImagenUrl.size() <= 2000
        && request.resource.data.ImagenUrl.matches('https://res[.]cloudinary[.]com/[A-Za-z0-9_-]+/image/upload/.+[.]jpg')
        && request.resource.data.ImagenPublicId is string && request.resource.data.ImagenPublicId.size() > 0
        && request.resource.data.ImagenPublicId.size() <= 300
        && request.resource.data.Descripcion is string && request.resource.data.Descripcion.size() <= 300
        && request.resource.data.CreadoEn == request.time;
      allow delete: if esBarberoHabilitado() && resource.data.BarberoId == request.auth.uid;
      allow update: if esBarberoHabilitado()
        && resource.data.BarberoId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Descripcion'])
        && request.resource.data.Descripcion is string
        && request.resource.data.Descripcion.size() <= 300;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
